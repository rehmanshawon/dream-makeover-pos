{
  "name": "@dream-makeover/backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend for Dream Makeover POS",
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.js",
    "test:integration": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.js --testRegex='.*\\.integration\\.spec\\.ts$' --runInBand",
    "build": "tsc -p tsconfig.build.json",
    "start:dev": "nest start --watch",
    "migration:run": "typeorm-ts-node-commonjs -d src/config/typeorm-cli.config.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/config/typeorm-cli.config.ts migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "mysql2": "^3.24.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2"
  }
}
